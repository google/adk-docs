# Copy this file to .env and fill in your own values.

# Choose your Live API platform
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# For Gemini Live API (when GOOGLE_GENAI_USE_VERTEXAI=FALSE)
GOOGLE_API_KEY=your_api_key_here

# For Gemini Live API on Agent Platform (when GOOGLE_GENAI_USE_VERTEXAI=TRUE).
# Live API models are not available in the `global` location, so use a regional
# endpoint such as us-central1, us-east1, or asia-northeast1.
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_CLOUD_LOCATION=us-east1

# Model selection (optional, defaults to the native audio model below)
DEMO_AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ...or the newer Gemini 3.1 Live model. It is lower latency, but it supports
# neither proactivity nor affective dialog, so leave both toggles off in the UI.
# DEMO_AGENT_MODEL=gemini-3.1-flash-live-preview

# ...or the Agent Platform model (requires GOOGLE_GENAI_USE_VERTEXAI=TRUE)
# DEMO_AGENT_MODEL=gemini-live-2.5-flash-native-audio
