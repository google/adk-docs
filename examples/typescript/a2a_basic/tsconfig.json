{
  "compilerOptions": {
    /* Build options. `module: nodenext` is required: every server here uses
       top-level `await`, which only works in an ES module. */
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Module interop */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["*.ts", "remote_a2a/**/*.ts"],
  "exclude": ["node_modules"]
}
